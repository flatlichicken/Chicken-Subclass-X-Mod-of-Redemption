<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\tModLoader.targets" />

    <PropertyGroup>
        <NoWarn>$(NoWarn);ChangeMagicNumberToID</NoWarn>
    </PropertyGroup>

    <!-- Local project reference for Chickensubclass -->
    <ItemGroup>
        <ProjectReference Include="..\Chickensubclass\Chickensubclass.csproj" />
    </ItemGroup>

    <!-- Remote or package reference fallback for Redemption -->
